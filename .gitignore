# --- KiCad ---
# Backups and autosaves
*-backups/
*.kicad_sch-bak
*.kicad_pcb-bak
*.kicad_pro-bak
*.bak
*.bck
_autosave-*
\#auto_saved_files#
*.lck
*.kicad_prl
fp-info-cache
~*.lck

# Generated outputs (regenerate from source)
*.net
*.drl
*.gbr
*.gbrjob
*.pos
*.rpt
*.erc
*.drc
production/
fabrication/

# ...except the Rev A fabrication files, kept exactly as sent to the fab (see README).  The zip
# that was uploaded is just these files zipped.
!hardware/fab/*.gbr
!hardware/fab/*.gbrjob
!hardware/fab/*.drl
hardware/fab/*.zip

# --- Datasheets and vendor files (copyrighted, do not redistribute) ---
docs/datasheets/

# --- SOLIDWORKS ---
# Lock files written next to an open part (~$name.SLDPRT)
~$*

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
.vscode/
.idea/

# --- PlatformIO ---
firmware/.pio/

# --- Python tooling ---
__pycache__/
*.pyc
.venv/

# VS Code Local History extension
.history/
